{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "VTM Design System 5.0 · Signal",
    "beschreibung": "Verbindliche Design-Token des VersicherungsTech Magazins. Drei Ebenen: primitiv, semantisch, komponentenbezogen. Spiegel von tokens.css.",
    "version": "5.0.0",
    "stand": "2026-08-05",
    "kontrast": "Alle als Text deklarierten Farben erfüllen WCAG 2.2 AA auf dem angegebenen Grund."
  },
  "farbe": {
    "nacht": {
      "950": { "$value": "#081226" },
      "900": { "$value": "#0D1C3C", "beschreibung": "Kernfarbe Nachtblau. Textfarbe und kompakter Anker. 16,8:1 auf Weiß." },
      "800": { "$value": "#142857" },
      "700": { "$value": "#1D3572" },
      "600": { "$value": "#28448D" }
    },
    "electric": {
      "700": { "$value": "#173BC4", "beschreibung": "Link- und Textvariante. 8,5:1 auf Weiß." },
      "600": { "$value": "#1F4EFF", "beschreibung": "Kernfarbe Electric. Aktivität, Auswahl, Daten, Interaktion. 5,85:1 auf Weiß." },
      "500": { "$value": "#4A6FFF" },
      "400": { "$value": "#7C96FF", "beschreibung": "Interaktion auf Nachtblau. 6,1:1." },
      "300": { "$value": "#A9BAFF" },
      "200": { "$value": "#CDD9FF" },
      "100": { "$value": "#E2EAFF" },
      "050": { "$value": "#F0F4FF" }
    },
    "eis": {
      "050": { "$value": "#F7FAFE" },
      "100": { "$value": "#EFF4FC" },
      "200": { "$value": "#E3EBF8" },
      "300": { "$value": "#D3DFF2" },
      "400": { "$value": "#BCCDE8" }
    },
    "neutral": {
      "700": { "$value": "#3A4763", "beschreibung": "Sekundärtext. 9,3:1 auf Weiß." },
      "500": { "$value": "#5C6980", "beschreibung": "Gedämpfter Text. 5,5:1 auf Weiß." },
      "400": { "$value": "#8791A3", "beschreibung": "Nur große Schrift oder Deko." },
      "300": { "$value": "#B6BFCF" },
      "200": { "$value": "#D5DBE6" },
      "100": { "$value": "#E8ECF2" },
      "050": { "$value": "#F4F6FA" }
    },
    "gold": {
      "700": { "$value": "#8A6512", "beschreibung": "Belegtext auf Weiß. 5,3:1. Ausschließlich Beleg, Quelle, verifizierter Wert." },
      "600": { "$value": "#A87D18", "beschreibung": "Große Schrift/Grafik. 3,7:1." },
      "500": { "$value": "#C9A035", "beschreibung": "Belegmarke, auf Nachtblau 6,9:1." },
      "400": { "$value": "#E7C878", "beschreibung": "Beleg auf Nachtblau. 10,4:1." },
      "100": { "$value": "#F7EFD8" },
      "050": { "$value": "#FBF7EA" }
    },
    "coral": {
      "700": { "$value": "#A63A24", "beschreibung": "Fehlertext. 6,5:1 auf Weiß. Nur Fehler, Ausschluss, Risiko." },
      "600": { "$value": "#C24B33" },
      "500": { "$value": "#E06A50", "beschreibung": "Nur Grafik oder große Darstellung." },
      "100": { "$value": "#FCE9E4" },
      "050": { "$value": "#FEF4F1" }
    },
    "mint": {
      "700": { "$value": "#0C6B4B", "beschreibung": "Erfolgstext. 6,5:1 auf Weiß. Nur Bestätigung, Erfolg, Zusage." },
      "600": { "$value": "#128760" },
      "500": { "$value": "#2BA57C", "beschreibung": "Nur Grafik oder große Darstellung." },
      "100": { "$value": "#DFF4EB" },
      "050": { "$value": "#F0FAF5" }
    },
    "weiss": { "$value": "#FFFFFF" },
    "papier": { "$value": "#FCFDFF" }
  },
  "typografie": {
    "familie": {
      "display": { "$value": "Schibsted Grotesk", "fallback": "Arial, sans-serif", "einsatz": "Display, Headlines, Kennzahlen" },
      "text": { "$value": "Inter", "fallback": "Segoe UI, Helvetica Neue, Arial, sans-serif", "einsatz": "UI, Fließtext, Formulare, Tabellen" },
      "serif": { "$value": "Newsreader", "fallback": "Georgia, Times New Roman, serif", "einsatz": "Redaktioneller Lesetext, Zitate, Essays" },
      "mono": { "$value": "IBM Plex Mono", "fallback": "Consolas, Courier New, monospace", "einsatz": "Quellen, Daten, Status, Zeitangaben" }
    },
    "groesse": {
      "2xs": { "$value": "0.6875rem" },
      "xs": { "$value": "0.75rem" },
      "s": { "$value": "0.875rem" },
      "m": { "$value": "1rem" },
      "l": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "clamp(1.9rem, 1.4rem + 2vw, 2.375rem)" },
      "5xl": { "$value": "clamp(2.2rem, 1.6rem + 3vw, 3rem)" },
      "6xl": { "$value": "clamp(2.6rem, 1.8rem + 4.5vw, 3.75rem)" },
      "7xl": { "$value": "clamp(3rem, 2rem + 6vw, 4.75rem)" }
    },
    "zeilenhoehe": {
      "display": { "$value": 1.06 },
      "heading": { "$value": 1.18 },
      "ui": { "$value": 1.45 },
      "text": { "$value": 1.6 },
      "artikel": { "$value": 1.7 }
    },
    "laufweite": {
      "display": { "$value": "-0.022em" },
      "heading": { "$value": "-0.012em" },
      "mono": { "$value": "0.01em" },
      "label": { "$value": "0.08em" }
    },
    "messung": {
      "artikel": { "$value": "42rem" },
      "text": { "$value": "38rem" },
      "lead": { "$value": "34rem" },
      "display": { "$value": "22ch" }
    }
  },
  "abstand": {
    "2": { "$value": "0.125rem" },
    "4": { "$value": "0.25rem" },
    "8": { "$value": "0.5rem" },
    "12": { "$value": "0.75rem" },
    "16": { "$value": "1rem" },
    "24": { "$value": "1.5rem" },
    "32": { "$value": "2rem" },
    "48": { "$value": "3rem" },
    "64": { "$value": "4rem" },
    "96": { "$value": "6rem" },
    "128": { "$value": "8rem" }
  },
  "radius": {
    "s": { "$value": "0.25rem" },
    "m": { "$value": "0.5rem" },
    "l": { "$value": "0.75rem" },
    "xl": { "$value": "1.25rem" },
    "rund": { "$value": "999px" }
  },
  "linie": {
    "haar": { "$value": "1px solid rgb(13 28 60 / 0.12)" },
    "mittel": { "$value": "1px solid rgb(13 28 60 / 0.20)" },
    "invers": { "$value": "1px solid rgb(255 255 255 / 0.22)" }
  },
  "schatten": {
    "s": { "$value": "0 1px 2px rgb(13 28 60 / 0.06)" },
    "m": { "$value": "0 4px 16px rgb(13 28 60 / 0.08)" },
    "l": { "$value": "0 12px 40px rgb(13 28 60 / 0.13)" }
  },
  "bewegung": {
    "dauer": {
      "micro": { "$value": "120ms" },
      "kurz": { "$value": "200ms" },
      "mittel": { "$value": "320ms" },
      "lang": { "$value": "560ms" }
    },
    "kurve": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
      "eintritt": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
      "austritt": { "$value": "cubic-bezier(0.4, 0, 1, 1)" }
    },
    "regel": "Bei prefers-reduced-motion: reduce entfallen alle automatischen Bewegungen; Übergänge werden auf 1ms reduziert."
  },
  "ebene": {
    "inhalt": { "$value": 0 },
    "sticky": { "$value": 100 },
    "dropdown": { "$value": 400 },
    "overlay": { "$value": 800 },
    "dialog": { "$value": 900 },
    "toast": { "$value": 1000 }
  },
  "semantik": {
    "text": { "$value": "{farbe.nacht.900}" },
    "text-sekundaer": { "$value": "{farbe.neutral.700}" },
    "text-gedaempft": { "$value": "{farbe.neutral.500}" },
    "text-invers": { "$value": "{farbe.weiss}" },
    "text-link": { "$value": "{farbe.electric.700}" },
    "flaeche-seite": { "$value": "{farbe.weiss}" },
    "flaeche-soft": { "$value": "{farbe.eis.050}" },
    "flaeche-eis": { "$value": "{farbe.eis.100}" },
    "flaeche-anker": { "$value": "{farbe.nacht.900}", "beschreibung": "Kompakter dunkler Anker. Keine langen dunkelblauen Seitenbereiche." },
    "aktion": { "$value": "{farbe.electric.600}" },
    "aktion-hover": { "$value": "{farbe.electric.700}" },
    "auswahl-flaeche": { "$value": "{farbe.electric.100}" },
    "auswahl-linie": { "$value": "{farbe.electric.600}" },
    "beleg-text": { "$value": "{farbe.gold.700}" },
    "beleg-marke": { "$value": "{farbe.gold.500}" },
    "beleg-flaeche": { "$value": "{farbe.gold.050}" },
    "erfolg-text": { "$value": "{farbe.mint.700}" },
    "erfolg-flaeche": { "$value": "{farbe.mint.050}" },
    "warnung-text": { "$value": "{farbe.gold.700}" },
    "fehler-text": { "$value": "{farbe.coral.700}" },
    "fehler-flaeche": { "$value": "{farbe.coral.050}" },
    "fokus": { "$value": "0 0 0 2px #FFFFFF, 0 0 0 4px #1F4EFF" },
    "deaktiviert-text": { "$value": "{farbe.neutral.400}" },
    "deaktiviert-flaeche": { "$value": "{farbe.neutral.050}" }
  },
  "komponenten": {
    "button": {
      "hoehe": { "$value": "2.75rem", "beschreibung": "44px Touchfläche, WCAG 2.5.8" },
      "radius": { "$value": "{radius.m}" },
      "primaer-bg": { "$value": "{semantik.aktion}" },
      "primaer-bg-hover": { "$value": "{semantik.aktion-hover}" }
    },
    "eingabefeld": {
      "hoehe": { "$value": "2.75rem" },
      "linie-fokus": { "$value": "{farbe.electric.600}" },
      "linie-fehler": { "$value": "{farbe.coral.600}" }
    },
    "navigation": { "hoehe": { "$value": "4rem" }, "aktiv-marker": { "$value": "2px solid {farbe.electric.600}" } },
    "karte": { "radius": { "$value": "{radius.l}" }, "linie": { "$value": "{linie.haar}" } },
    "artikel": { "messung": { "$value": "42rem" }, "lesetext": { "$value": "400 1.125rem/1.7 Newsreader" } },
    "datenbox": { "wert": { "$value": "700 {typografie.groesse.4xl}/1.05 Schibsted Grotesk" }, "quelle": { "$value": "500 0.75rem/1.5 IBM Plex Mono, Farbe gold.700" } },
    "diagramm": {
      "standard": { "$value": "{farbe.electric.600}" },
      "sekundaer": { "$value": "{farbe.electric.300}" },
      "tertiaer": { "$value": "{farbe.nacht.700}" },
      "beleg": { "$value": "{farbe.gold.500}", "beschreibung": "Nur der entscheidende oder belegte Wert." },
      "maxRingsegmente": { "$value": 5 }
    },
    "dialog": { "radius": { "$value": "{radius.xl}" }, "schleier": { "$value": "rgb(8 18 38 / 0.55)" }, "maxBreite": { "$value": "34rem" } },
    "tooltip": { "bg": { "$value": "{farbe.nacht.900}" } },
    "tabelle": { "kopf-bg": { "$value": "{farbe.eis.050}" }, "zahlen": { "$value": "IBM Plex Mono, rechtsbündig, tabellarische Ziffern" } },
    "tabs": { "aktiv-marker": { "$value": "2px solid {farbe.electric.600}" } },
    "status": { "radius": { "$value": "{radius.rund}" }, "font": { "$value": "600 0.75rem IBM Plex Mono" } },
    "newsletter": { "breite": { "$value": "600px" }, "akzent": { "$value": "{farbe.electric.600}" } },
    "dokument": { "rand": { "$value": "22mm" }, "grundschrift": { "$value": "10.5pt Inter" } },
    "praesentation": { "titel": { "$value": "40pt Schibsted Grotesk Bold" }, "text": { "$value": "16pt Inter" }, "meta": { "$value": "11pt IBM Plex Mono" } }
  }
}
